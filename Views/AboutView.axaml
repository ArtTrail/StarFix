<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StarFix.Views.AboutView">

    <Border Padding="36,28,36,28">
        <StackPanel Spacing="0">

            <Image Source="avares://StarFix/Assets/StarFix_logo.png" Width="120" Height="120"
                   HorizontalAlignment="Center" Margin="0,0,0,12"/>

            <TextBlock Classes="title"
                       Text="StarFix"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="VersionText"
                       Classes="hint"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0"/>

            <TextBlock Classes="hint"
                       Text="© Art Trail 2026"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0"/>

            <Rectangle Height="1" Fill="{StaticResource BrushSep}" Margin="0,18,0,18"/>

            <TextBlock Text="Author" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="Art Trail" HorizontalAlignment="Center" Margin="0,4,0,2"/>

            <TextBlock TextWrapping="Wrap"
                       Classes="hint"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       FontStyle="Italic"
                       Margin="0,10,0,0"
                       Text="Developed entirely with Claude Code (Anthropic)."/>

            <Rectangle Height="1" Fill="{StaticResource BrushSep}" Margin="0,18,0,18"/>

            <TextBlock Text="Acknowledgements" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,12"/>

            <TextBlock TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                       Text="Gaia DR3 (ESA)"/>
            <TextBlock TextWrapping="Wrap" Classes="hint" HorizontalAlignment="Center" TextAlignment="Center"
                       Margin="0,2,0,10"
                       Text="Astrometric reference catalog, built directly from gaiadr3.gaia_source_lite&#x0a;gea.esac.esa.int"/>

            <TextBlock TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                       Text="astroalign"/>
            <TextBlock TextWrapping="Wrap" Classes="hint" HorizontalAlignment="Center" TextAlignment="Center"
                       Margin="0,2,0,10"
                       Text="Asterism/triangle-matching star-pattern registration (MIT license)&#x0a;github.com/quatrope/astroalign"/>

            <TextBlock TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                       Text="astropy / photutils"/>
            <TextBlock TextWrapping="Wrap" Classes="hint" HorizontalAlignment="Center" TextAlignment="Center"
                       Margin="0,2,0,0"
                       Text="FITS I/O, WCS fitting, and star detection&#x0a;astropy.org  ·  photutils.readthedocs.io"/>

            <Rectangle Height="1" Fill="{StaticResource BrushSep}" Margin="0,18,0,18"/>

            <TextBlock Text="License" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock TextWrapping="Wrap" Classes="hint" HorizontalAlignment="Center" TextAlignment="Center"
                       Text="Released under the MIT License.&#x0a;See the LICENSE file included with StarFix for the full text."/>

        </StackPanel>
    </Border>

</UserControl>
