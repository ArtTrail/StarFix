<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StarFix.ViewModels"
        x:Class="StarFix.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings"
        Width="480" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="24" Spacing="14">

        <TextBlock Classes="h2" Text="Solve output"/>
        <CheckBox Content="Overwrite existing files (write WCS in place)" IsChecked="{Binding OverwriteExisting}"/>
        <TextBlock Classes="hint" TextWrapping="Wrap"
                   Text="When off, each solve writes a new '&lt;file&gt;_solved_N.fits' copy instead of touching the original."/>

        <TextBlock Classes="h2" Text="Defaults" Margin="0,10,0,0"/>
        <StackPanel Spacing="4">
            <TextBlock Text="Default search radius (deg)" Classes="hint"/>
            <NumericUpDown Value="{Binding DefaultSearchRadiusDeg}" Minimum="0.05" Maximum="10" Increment="0.1" FormatString="F2"/>
        </StackPanel>

        <TextBlock Classes="h2" Text="Gaia catalog" Margin="0,10,0,0"/>
        <StackPanel Spacing="4">
            <TextBlock Text="Catalog folder" Classes="hint"/>
            <TextBox Text="{Binding GaiaCatalogPath}"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
            <Button Classes="toolbar" Content="Cancel" Command="{Binding CancelCommand}"/>
            <Button Classes="primary" Content="Save" Command="{Binding SaveCommand}"/>
        </StackPanel>

    </StackPanel>
</Window>
